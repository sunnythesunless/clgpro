# ============================================
# Automated Medical Image Reporting - Backend
# ============================================

# App Settings
APP_NAME=Medical Image Reporter
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, use * for development)
ALLOWED_ORIGINS=["*"]

# Database (SQLite - no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./medical_reports.db

# JWT Authentication
SECRET_KEY=medical-image-reporter-dev-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model (Pre-trained BLIP - auto-downloads from HuggingFace)
MODEL_NAME=Salesforce/blip-image-captioning-large
DEVICE=cpu

# Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
